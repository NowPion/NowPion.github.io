  <diagram id="hardware-wiring" name="极简硬件接线图">
    <mxGraphModel dx="1100" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="580" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="2" value="&lt;b&gt;&lt;font style=&#x27;font-size: 18px; color: #0f172a;&#x27;&gt;Dell Wyse 3040 + 无线路由器 极简硬件接线图&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size: 12px; color: #64748b;&#x27;&gt;总共只需 2 根普通网线，无需交换机，全寝室手机/电脑无感畅连&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="980" height="55" as="geometry" /></mxCell>
<mxCell id="3" value="&lt;b&gt;【1】宿舍墙壁网口&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;color:#0284c7;&#x27;&gt;&lt;b&gt;RJ45 插口&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#64748b;&#x27;&gt;校园网出口&lt;br/&gt;(172.20.59.x)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="150" height="160" as="geometry" /></mxCell>
<mxCell id="4" value="&lt;b&gt;【2】普通无线路由器 (如小米/TP-Link)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#1e40af;&#x27;&gt;管理后台: 192.168.1.1 &amp;nbsp;|&amp;nbsp; DHCP 下发网关: &lt;b&gt;192.168.1.254&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;shadow=1;align=center;verticalAlign=top;spacingTop=10;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="280" y="105" width="420" height="195" as="geometry" /></mxCell>
<mxCell id="5" value="&lt;b&gt;WAN 口&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;[蓝色]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0284c7;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="300" y="165" width="75" height="60" as="geometry" /></mxCell>
<mxCell id="6" value="&lt;b&gt;Wi-Fi 天线&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:9px;&#x27;&gt;无线射频&lt;/font&gt;" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#3b82f6;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="395" y="165" width="60" height="60" as="geometry" /></mxCell>
<mxCell id="7" value="&lt;b&gt;LAN 2 口&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;[黄色]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#eab308;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="480" y="165" width="75" height="60" as="geometry" /></mxCell>
<mxCell id="8" value="&lt;b&gt;LAN 1 口&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;[黄色]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d97706;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="585" y="165" width="90" height="60" as="geometry" /></mxCell>
<mxCell id="9" value="&lt;font style=&#x27;font-size:10px;color:#475569;&#x27;&gt;WAN接外网 &amp;nbsp;|&amp;nbsp; Wi-Fi连移动端 &amp;nbsp;|&amp;nbsp; LAN2接台式机 &amp;nbsp;|&amp;nbsp; LAN1接旁路由&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="290" y="250" width="400" height="25" as="geometry" /></mxCell>
<mxCell id="10" value="&lt;b&gt;【3】Dell Wyse 3040 (iStoreOS 旁路由)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px;color:#065f46;&#x27;&gt;单口工控机 / 4W 低功耗&lt;br/&gt;静态 IP: &lt;b&gt;192.168.1.254&lt;/b&gt;&lt;br/&gt;网关指向: 192.168.1.1&lt;br/&gt;运行脚本: 自动认证 + TTL=64&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;shadow=1;align=center;verticalAlign=top;spacingTop=10;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="780" y="105" width="230" height="195" as="geometry" /></mxCell>
<mxCell id="11" value="&lt;b&gt;单千兆网口 (eth0)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#fef08a;&#x27;&gt;192.168.1.254&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#047857;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="805" y="210" width="180" height="60" as="geometry" /></mxCell>
<mxCell id="12" value="&lt;b&gt;【4】全宿舍终端设备 (通过 DHCP 自动获取 IP，网关默认指向 192.168.1.254)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#faf5ff;strokeColor=#8b5cf6;strokeWidth=1.5;dashed=1;align=center;verticalAlign=top;spacingTop=8;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="970" height="140" as="geometry" /></mxCell>
<mxCell id="13" value="📱 &lt;b&gt;手机 / 平板 / 笔记本&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#64748b;&#x27;&gt;无线连接路由器 Wi-Fi&lt;br/&gt;免登录无感直接上网&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="280" y="380" width="210" height="75" as="geometry" /></mxCell>
<mxCell id="14" value="🖥️ &lt;b&gt;宿舍台式电脑 PC&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#047857;&#x27;&gt;网线插路由器 &lt;b&gt;LAN 2 口&lt;/b&gt;&lt;br/&gt;千兆有线低延迟对战&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="570" y="380" width="210" height="75" as="geometry" /></mxCell>
<mxCell id="15" value="&lt;b&gt;【网线 ①】&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;插 WAN 口&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=3;fontColor:#0369a1;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" edge="1" parent="1" source="3" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="16" value="&lt;b&gt;【网线 ②】&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#d97706;&#x27;&gt;LAN 1 直插 Wyse&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d97706;strokeWidth=4;fontColor:#b45309;fontSize=11;labelBackgroundColor=#ffffff;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" edge="1" parent="1" source="8" target="11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="17" value="&lt;b&gt;【网线 ③】(可选有线)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#16a34a;strokeWidth=2.5;fontColor:#15803d;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" edge="1" parent="1" source="7" target="14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="517" y="315" /><mxPoint x="675" y="315" /></Array></mxGeometry></mxCell>
<mxCell id="18" value="&lt;b&gt;Wi-Fi 5G&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#3b82f6;strokeWidth=2;dashed=1;fontColor:#1d4ed8;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" edge="1" parent="1" source="6" target="13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="315" /><mxPoint x="385" y="315" /></Array></mxGeometry></mxCell>
<mxCell id="19" value="💡 &lt;b&gt;接线核心口诀：&lt;/b&gt; 墙壁网线插 &lt;b&gt;WAN&lt;/b&gt; 口，Wyse 旁路由网线插 &lt;b&gt;LAN 1&lt;/b&gt; 口，台式机插 &lt;b&gt;LAN 2&lt;/b&gt; 口，手机连 &lt;b&gt;Wi-Fi&lt;/b&gt;。路由器后台把 DHCP 网关改成 &lt;b&gt;192.168.1.254&lt;/b&gt; 即大功告成！" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fefce8;strokeColor=#facc15;strokeWidth=1.5;fontColor=#854d0e;align=center;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="980" height="38" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>