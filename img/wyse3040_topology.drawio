<mxCell id="10" value="&lt;b&gt;WAN 口&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;[蓝色千兆]&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:9px;&#x27;&gt;172.20.59.194&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0284c7;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="85" y="362" width="95" height="60" as="geometry" /></mxCell>
