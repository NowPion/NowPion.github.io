<mxCell id="12" value="&lt;b&gt;LAN 2 口&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;[黄色千兆]&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:9px;&#x27;&gt;连宿舍台式PC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eab308;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="315" y="362" width="95" height="60" as="geometry" /></mxCell>
<mxCell id="13" value="&lt;b&gt;LAN 3 / 4&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;[闲置/备用]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#475569;strokeColor=#ffffff;strokeWidth=1;fontColor=#cbd5e1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="430" y="362" width="85" height="60" as="geometry" /></mxCell>
<mxCell id="14" value="&lt;b&gt;Wi-Fi 射频天线&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:9px;&#x27;&gt;2.4G &amp; 5GHz&lt;br/&gt;SSID: Dorm-WiFi&lt;/font&gt;" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#3b82f6;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="570" y="350" width="75" height="75" as="geometry" /></mxCell>
<mxCell id="15" value="&lt;b&gt;路由器核心网络配置 (Router Settings)&lt;/b&gt;&lt;br/&gt;&lt;table style=&#x27;width:100%;font-size:11px;text-align:left;border-collapse:collapse;color:#1e293b;margin-top:4px;&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;width:95px;font-weight:bold;color:#1e40af;&#x27;&gt;WAN 接口:&lt;/td&gt;&lt;td&gt;从校园网自动 DHCP 获取 IP: &lt;b&gt;172.20.59.194&lt;/b&gt; / 掩码: 255.255.255.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#1e40af;&#x27;&gt;LAN 接口:&lt;/td&gt;&lt;td&gt;固定管理 IP: &lt;b&gt;192.168.1.1&lt;/b&gt; / 掩码: 255.255.255.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#d97706;&#x27;&gt;DHCP 服务器:&lt;/td&gt;&lt;td&gt;&lt;b&gt;保持开启&lt;/b&gt; (动态分配 IP 池: 192.168.1.100 ~ 192.168.1.200)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#dc2626;&#x27;&gt;★ 核心网关:&lt;/td&gt;&lt;td&gt;&lt;b style=&#x27;color:#dc2626;background:#fef2f2;&#x27;&gt;强制下发网关为: 192.168.1.254&lt;/b&gt; (Option 3 指向 Wyse 3040)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#dc2626;&#x27;&gt;★ 核心 DNS:&lt;/td&gt;&lt;td&gt;&lt;b style=&#x27;color:#dc2626;background:#fef2f2;&#x27;&gt;强制下发 DNS 为: 192.168.1.254&lt;/b&gt; (Option 6 指向 Wyse 3040)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#059669;&#x27;&gt;运作优势:&lt;/td&gt;&lt;td&gt;全寝室室友手机/笔记本连上即走旁路由防检通道，无需手动设置静态 IP！&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="65" y="450" width="620" height="245" as="geometry" /></mxCell>
<mxCell id="16" value="&lt;b&gt;&lt;font style=&#x27;font-size: 15px; color: #065f46;&#x27;&gt;【核心旁路由】Dell Wyse 3040 (iStoreOS x86_64 旁路网关 / 4W 低功耗主机)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="770" y="290" width="770" height="430" as="geometry" /></mxCell>
<mxCell id="17" value="&lt;b&gt;Dell Wyse 3040 硬件规格与单网口面板&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#064e3b;strokeColor=#047857;strokeWidth=1.5;fontColor=#ffffff;align=center;verticalAlign=top;spacingTop=6;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="795" y="330" width="720" height="105" as="geometry" /></mxCell>
<mxCell id="18" value="&lt;b&gt;单千兆网口 (eth0)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;&#x27;&gt;[Realtek RTL8111 GbE]&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#fef08a;&#x27;&gt;IP: 192.168.1.254/24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#047857;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="815" y="362" width="180" height="60" as="geometry" /></mxCell>
<mxCell id="19" value="&lt;table style=&#x27;width:100%;font-size:11px;text-align:left;color:#ffffff;line-height:1.4;&#x27;&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;CPU:&lt;/b&gt; Intel Atom x5-Z8350 (4核 1.44~1.92GHz)&lt;/td&gt;&lt;td&gt;• &lt;b&gt;超低功耗:&lt;/b&gt; ~4W 极低发热/0静音&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;内存:&lt;/b&gt; 2GB LPDDR3 高速双通道内存&lt;/td&gt;&lt;td&gt;• &lt;b&gt;引导机制:&lt;/b&gt; 64位纯 UEFI 固件启动&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;• &lt;b&gt;板载存储:&lt;/b&gt; 8GB eMMC (预装 iStoreOS 22.03)&lt;/td&gt;&lt;td&gt;• &lt;b&gt;小巧机身:&lt;/b&gt; 10cm x 10cm 巴掌体积&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#065f46;strokeColor=#047857;strokeWidth=1;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1020" y="362" width="475" height="60" as="geometry" /></mxCell>
<mxCell id="20" value="&lt;b&gt;iStoreOS 核心防检测机制与网关引擎 (Bypass &amp; Anti-Detection Engine)&lt;/b&gt;&lt;br/&gt;&lt;table style=&#x27;width:100%;font-size:11px;text-align:left;border-collapse:collapse;color:#1e293b;margin-top:4px;&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;width:125px;font-weight:bold;color:#065f46;&#x27;&gt;① 全局 NAT 伪装:&lt;/td&gt;&lt;td&gt;&lt;b&gt;iptables -t nat -A POSTROUTING -j MASQUERADE&lt;/b&gt; (内网设备源IP统一伪装为 192.168.1.254)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#065f46;&#x27;&gt;② 锁死固定 TTL=64:&lt;/td&gt;&lt;td&gt;&lt;b&gt;iptables -t mangle -A POSTROUTING -j TTL --ttl-set 64&lt;/b&gt; (抹除路由衰减与跳数差异，破除校园网 AC 判定)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#065f46;&#x27;&gt;③ 禁用 TCP 时间戳:&lt;/td&gt;&lt;td&gt;&lt;b&gt;sysctl -w net.ipv4.tcp_timestamps=0&lt;/b&gt; (消除跨系统时钟偏移 Clock Skew 指纹)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#065f46;&#x27;&gt;④ 旁路网关网络参数:&lt;/td&gt;&lt;td&gt;IPv4 地址: &lt;b&gt;192.168.1.254&lt;/b&gt; | 默认网关: &lt;b&gt;192.168.1.1&lt;/b&gt; | DNS: &lt;b&gt;223.5.5.5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#c2410c;&#x27;&gt;⑤ 自研 Portal 看门狗:&lt;/td&gt;&lt;td&gt;常驻守护脚本: &lt;b&gt;/root/gwifi_login.py&lt;/b&gt; (Python 3.13 编写) + Crontab 周期性健康自检&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;font-weight:bold;color:#c2410c;&#x27;&gt;⑥ 掉线秒级自动重登:&lt;/td&gt;&lt;td&gt;探测 223.5.5.5 丢包即秒级触发 AES-128-CBC 认证令牌握手 172.31.0.50，全寝免登无感上网！&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="795" y="450" width="720" height="245" as="geometry" /></mxCell>
<mxCell id="21" value="&lt;b&gt;【核心直连网线】Cat6 千兆双绞线&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px;color:#d97706;&#x27;&gt;旁路数据吞吐总线 (1000Mbps)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;shadow=1;align=center;verticalAlign=middle;fontColor:#b45309;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="675" y="345" width="130" height="50" as="geometry" /></mxCell>
<mxCell id="22" value="&lt;b&gt;&lt;font style=&#x27;font-size: 14px; color: #4c1d95;&#x27;&gt;【全宿舍多终端设备群】(Client Devices Pool - 享受无限制、无感、高速并发上网)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#faf5ff;strokeColor=#8b5cf6;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=8;fontFamily=Segoe UI,Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="1500" height="215" as="geometry" /></mxCell>
